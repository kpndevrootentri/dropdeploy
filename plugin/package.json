{
  "name": "entrify-deploy",
  "version": "1.4.0",
  "description": "Deploy repositories and HTML pages to Entrify from the terminal, the Claude Code /deploy skill or Claude Desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kpndevrootentri/entrify-cli.git"
  },
  "type": "module",
  "bin": {
    "entrify": "dist/cli.js",
    "dropdeploy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
