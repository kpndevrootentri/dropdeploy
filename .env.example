# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dropdeploy"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Set to Redis's `requirepass` (recommended even on localhost).
REDIS_PASSWORD=""

# Auth
JWT_SECRET="your-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENV_ENCRYPTION_KEY=""

# Docker
DOCKER_SOCKET="/var/run/docker.sock"

# Per-build limits (every RUN step of a Docker build). Several builds run at
# once on the host that also serves every site, so keep the total under RAM.
BUILD_MEMORY_MB="3072"
BUILD_CPUS="2"

# How long a new container has to answer HTTP before the deploy fails and the
# previous deployment stays live (zero-downtime deploys).
# CONTAINER_READY_TIMEOUT_MS="90000"

# Storage directories (auto-created if they don't exist)
# PROJECTS_DIR defaults to ~/.dropdeploy/projects
# DOCKER_DATA_DIR defaults to ~/.dropdeploy/docker
PROJECTS_DIR=""
DOCKER_DATA_DIR=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Deployment
BASE_DOMAIN="app.ayile.in.app"

# Dev (localhost): when NEXT_PUBLIC_APP_URL contains localhost, deployed project URLs
# show as http://localhost:<port>. Set NEXT_PUBLIC_USE_LOCALHOST_DEPLOY_URL=true to
# force localhost URLs without changing NEXT_PUBLIC_APP_URL.

# Self-service sign-up via POST /api/auth/register. Leave off unless you add
# email verification: emails are not verified, so an open sign-up lets anyone
# claim an address on a domain you grant project access to by email domain.
ALLOW_PUBLIC_REGISTRATION="false"

# Build-time package scanning. BLOCKED_PACKAGES adds names to the built-in
# blocklist; ALLOWED_PACKAGES exempts names from it (e.g. "colors,faker", which
# are listed because old versions were compromised). Comma-separated.
# BLOCKED_PACKAGES=""
# ALLOWED_PACKAGES=""

# ── Custom domains ────────────────────────────────────────────────────────────
# Master switch. Off by default: with it off nothing in this section is read,
# the proxy never resolves custom hosts, and the ask endpoint denies every
# certificate order. This is also the rollback lever.
CUSTOM_DOMAINS_ENABLED="false"

# Certificate issuance, separately switchable. Turning this off stops all new
# ACME orders while already-issued domains keep serving.
TLS_CHECK_ENABLED="false"

# What users point their DNS at. The apex A-record target and the CNAME target
# for sub-domains; both are shown verbatim in the dashboard.
PLATFORM_INGRESS_IP=""

# Where the domain worker reaches the TLS edge to trigger certificate issuance
# (a handshake with the hostname as SNI). Caddy uses host networking, so the
# default of loopback is right unless the edge runs elsewhere.
# EDGE_TLS_ADDRESS="127.0.0.1:443"
CUSTOM_DOMAIN_CNAME_TARGET=""

# Shared secret between the Caddy edge and /api/internal/tls-check. Generate
# with:  openssl rand -hex 32
# Required whenever TLS_CHECK_ENABLED is true — without it the ask endpoint
# fails closed, which stops issuance entirely.
INTERNAL_EDGE_TOKEN=""

# Optional comma-separated hostnames nobody may claim as a custom domain.
CUSTOM_DOMAIN_DENYLIST=""

# Optional comma-separated hostnames that belong to the platform itself —
# monitoring aliases, staging CNAMEs, health checks that connect by name.
# BASE_DOMAIN, APP_URL's host, localhost and IP literals are already exempt;
# any OTHER named host is 404'd once CUSTOM_DOMAINS_ENABLED is true, so list
# them here. Sub-domains of each entry are covered too.
PLATFORM_EXTRA_HOSTS=""
